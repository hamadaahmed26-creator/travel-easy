{
  "expo": {
    "name": "TripOpt",
    "slug": "tripopt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tripopt",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Optimise your whole trip — flights + hotels + dates — like a portfolio. Hit Surprise Me for a mystery destination.",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#05070F"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "TripOpt",
      "shortName": "TripOpt",
      "description": "Optimise your whole trip — flights + hotels + dates — like a portfolio.",
      "themeColor": "#5B8FFF",
      "backgroundColor": "#05070F"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#05070F"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
